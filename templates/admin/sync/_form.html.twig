{% set categories = hookable_metadata.context.categories %}
{% set credentialsSet = hookable_metadata.context.credentialsSet %}
{% set channels = hookable_metadata.context.channels %}
{% set channelCode = hookable_metadata.context.channelCode %}

<div class="container-xl">
    {% if not credentialsSet %}
        <div class="alert alert-danger" role="alert">
            {{ 'sylius.ui.admin.priceeio_sync_plugin.index.credentials_missing'|trans }}
        </div>
    {% endif %}

    <div class="card p-3 mb-3">
        <h3 class="card-title mb-3">{{ 'sylius.ui.admin.priceeio_sync_plugin.index.subtitle'|trans }}</h3>

        <form id="priceeio-sync-form">
            <input type="hidden" name="_token" value="{{ csrf_token('priceeio_categories') }}">

            <!-- Channel: each one is a website on Pricee.io, with its own API key -->
            {% if channels|length > 1 %}
                <div class="mb-4">
                    <label class="form-label" for="priceeio-sync-channel">{{ 'sylius.ui.admin.priceeio_sync_plugin.index.channel'|trans }}</label>
                    <select class="form-select" id="priceeio-sync-channel" name="channel">
                        {% for channel in channels %}
                            <option value="{{ channel.code }}" {{ channel.code == channelCode ? 'selected' }}>{{ channel.name }} ({{ channel.url }})</option>
                        {% endfor %}
                    </select>
                    <div class="form-text">{{ 'sylius.ui.admin.priceeio_sync_plugin.index.channel_help'|trans }}</div>
                </div>
            {% else %}
                <input type="hidden" name="channel" value="{{ channelCode }}">
            {% endif %}

            <!-- Categories -->
            <h4>{{ 'sylius.ui.admin.priceeio_sync_plugin.index.categories_title'|trans }}</h4>
            <hr class="mt-0 mb-4">

            <div id="priceeio-sync-loading" class="d-none mt-2 mb-4 text-muted">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">{{ 'sylius.ui.admin.priceeio_sync_plugin.index.loading'|trans }}</span>
                </div>
                {{ 'sylius.ui.admin.priceeio_sync_plugin.index.loading'|trans }}
            </div>
            <div id="priceeio-sync-result" class="mt-2 mb-4"></div>

            <div class="mb-3">
                {% for category in categories %}
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="categories[]"
                               value="{{ category.code }}"
                               id="category-{{ category.code }}">
                        <label class="form-check-label" for="category-{{ category.code }}">
                            {{ category.name }} ({{ category.productCount }})
                        </label>
                    </div>
                {% endfor %}
            </div>

            <button type="submit" class="btn btn-primary">
                {{ 'sylius.ui.admin.priceeio_sync_plugin.index.sync_button'|trans }}
            </button>
        </form>
    </div>
</div>

<script>
// The sync runs in batches, one request each, so a large selection never
// hits a timeout: each answer gives the cursor for the next batch.
document.getElementById('priceeio-sync-form').addEventListener('submit', function (e) {
    e.preventDefault();

    const form = e.target;
    const button = form.querySelector('button[type="submit"]');
    const result = document.getElementById('priceeio-sync-result');
    const loading = document.getElementById('priceeio-sync-loading');
    let synced = 0;
    let failed = 0;

    const show = (type, message) => {
        result.className = 'alert alert-' + type + ' mt-2';
        result.innerText = message;
    };
    const finish = () => {
        loading.classList.add('d-none');
        button.disabled = false;
    };
    const syncedMessage = () => synced + ' ' + '{{ "sylius.ui.admin.priceeio_sync_plugin.index.synced_products"|trans|e('js') }}'
        + (failed > 0 ? ' ' + failed + ' ' + '{{ "sylius.ui.admin.priceeio_sync_plugin.index.failed_products"|trans|e('js') }}' : '');
    const fail = (message) => {
        finish();
        show('danger', '{{ "sylius.ui.admin.priceeio_sync_plugin.index.sync_error"|trans|e('js') }}'
            + (message ? ' ' + message : '')
            + (synced + failed > 0 ? ' (' + syncedMessage() + ')' : ''));
    };

    button.disabled = true;
    loading.classList.remove('d-none');
    result.className = 'd-none';

    const syncBatch = (afterId) => {
        const body = new FormData(form);
        body.append('after_id', afterId);

        fetch('{{ path('app_admin_priceeio_sync_run') }}', {
            method: 'POST',
            body: body,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                fail(data.error);

                return;
            }

            synced += data.synced;
            failed += data.failed;
            if (data.done) {
                finish();
                show(failed > 0 ? 'warning' : 'success', syncedMessage());

                return;
            }

            show('info', '{{ "sylius.ui.admin.priceeio_sync_plugin.index.sync_progress"|trans|e('js') }} ' + (synced + failed) + ' / ' + data.total);
            syncBatch(data.last_id);
        })
        .catch(() => fail());
    };

    syncBatch(0);
});

// The categories and their product counts are the chosen channel's
const channelSelect = document.getElementById('priceeio-sync-channel');
if (channelSelect) {
    channelSelect.addEventListener('change', function () {
        const url = new URL(window.location.href);
        url.searchParams.set('channel', this.value);
        window.location.href = url.toString();
    });
}
</script>
